# Keep the build context small and avoid shipping dev-only / generated
# content into the image (Dockerfile only COPYs backend/, mcp_server/,
# and data/processed/ explicitly, but Docker still reads the whole build
# context from disk before filtering -- this keeps that step fast).
.git/
.venv_mcp/
logs/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

frontend/node_modules/
frontend/dist/

data/raw/
data/interim/

UI ideas/
eda/
sentiment_classification/
topic_modelling/
scripts/
tests/
